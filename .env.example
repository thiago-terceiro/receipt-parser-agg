# AI Model Configuration
HF_TOKEN=hf_replace_me
HF_MODEL_ID=Qwen/Qwen2.5-VL-7B-Instruct
HF_PROVIDER=hf-inference
HF_MAX_OUTPUT_TOKENS=1600

# Telemetry & Honeycomb Configuration
HONEYCOMB_API_KEY=replace_with_your_honeycomb_api_key
# Optional: Set to https://api.eu1.honeycomb.io if using Honeycomb EU region
# HONEYCOMB_API_ENDPOINT=https://api.honeycomb.io/v1/traces

# Server-Side OpenTelemetry (@vercel/otel)
OTEL_SERVICE_NAME=receipt-ai-frontend
OTEL_EXPORTER_OTLP_ENDPOINT=https://api.honeycomb.io
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=replace_with_your_honeycomb_api_key

# Browser-Side OpenTelemetry (Honeycomb Web SDK)
NEXT_PUBLIC_OTEL_BROWSER_ENABLED=true
NEXT_PUBLIC_OTEL_BROWSER_SERVICE_NAME=receipt-ai-browser
# Defaults to internal proxy /api/otel/v1/traces (avoids exposing API keys or needing Docker).
# NEXT_PUBLIC_OTEL_BROWSER_COLLECTOR_URL=/api/otel/v1/traces
NEXT_PUBLIC_OTEL_BROWSER_ENABLED_ENVIRONMENTS=development,preview,production
NEXT_PUBLIC_OTEL_BROWSER_SAMPLE_RATE=1
NEXT_PUBLIC_OTEL_BROWSER_DEBUG=false

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-your-service-role-key

# NextAuth Configuration
AUTH_SECRET=replace-with-a-random-secret-key-min-32-chars
# NEXTAUTH_URL=http://localhost:3000

# Google OAuth Provider
AUTH_GOOGLE_ID=replace-with-google-client-id
AUTH_GOOGLE_SECRET=replace-with-google-client-secret

# GitHub OAuth Provider
AUTH_GITHUB_ID=replace-with-github-client-id
AUTH_GITHUB_SECRET=replace-with-github-client-secret
# Fallback: GITHUB_ID, GITHUB_SECRET

# Credentials & Test Auth (optional, enabled by default in non-production)
# ENABLE_TEST_AUTH=true
# TEST_AUTH_PASSWORD=password123