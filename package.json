    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/otel": "^2.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
