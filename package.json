{
  "name": "receipt-ai-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4+sha512.1c67b3b359b2d408119ba1ed289f34b8fc3c6873412bec6fd264fbdc82489e510fcbecb9ce9d22dae7f3b76269d8441046014bdca53b9979cd7a561ad631b800",
  "engines": {
    "node": ">=22.13.1"
  },
  "scripts": {
    "dev": "next dev",
    "prepare": "husky",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build": "next build",
    "ci:verify": "tsc --noEmit && eslint . && jest --runInBand",
    "db:check": "pnpm run db:lint && pnpm run db:push:dry-run",
    "db:deploy": "pnpm run db:check && pnpm run db:push",
    "db:diff": "supabase db diff",
    "db:lint": "supabase db lint --linked",
    "db:push": "supabase db push",
    "db:push:dry-run": "supabase db push --dry-run",
    "db:push:yes": "supabase db push --yes",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:status": "supabase status",
    "migration:list": "supabase migration list",
    "migration:new": "supabase migration new",
    "migration:repair": "supabase migration repair",
    "migrate:redis-to-supabase": "tsx ./scripts/migrate-redis-to-supabase.ts",
    "start": "next start",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ocr": "tsx ./scripts/test-live-gemini-ocr.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "validate:redis-migration": "tsx ./scripts/validate-redis-migration.ts"
  },
  "dependencies": {
